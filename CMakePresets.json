{
    "version": 2,
    "configurePresets": [
        {
            "name": "vcpkg+ninja",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build"
        },
        {
            "name": "wayland",
            "hidden": true,
            "inherits": "vcpkg+ninja",
            "cacheVariables": {
                "GLFW_BUILD_WAYLAND": "ON",
                "GLFW_BUILD_X11": "OFF"
            }
        },
        {
            "name": "debug",
            "inherits": "vcpkg+ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "inherits": "vcpkg+ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "debug-wayland",
            "inherits": "wayland",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release-wayland",
            "inherits": "wayland",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ]
}